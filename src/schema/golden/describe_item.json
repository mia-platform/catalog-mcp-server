{
  "additionalProperties": false,
  "properties": {
    "direction": {
      "anyOf": [
        {
          "enum": [
            "inbound",
            "outbound"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Restrict relationships to one direction."
    },
    "group": {
      "description": "The kind's API group. Only needed when several types share the kind.",
      "type": [
        "string",
        "null"
      ]
    },
    "group_by": {
      "anyOf": [
        {
          "enum": [
            "direction",
            "type"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Group relationships by direction (default) or by relationship type."
    },
    "include_relationships": {
      "default": true,
      "description": "Return the item's relationships. Default true.",
      "type": "boolean"
    },
    "include_spec": {
      "default": true,
      "description": "Return the item's spec. Default true.",
      "type": "boolean"
    },
    "kind": {
      "description": "Only needed when the name is ambiguous.",
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "description": "The item's name.",
      "type": "string"
    },
    "relationship_cursor": {
      "description": "Opaque continuation for relationships only.",
      "type": [
        "string",
        "null"
      ]
    },
    "relationship_limit": {
      "description": "Maximum relationships returned. Default 50, clamped to 200.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "name"
  ],
  "type": "object"
}
